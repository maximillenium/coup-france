# ------------------------------------------------------------------------------
# CoupFranc Environment Variables Configuration
# ------------------------------------------------------------------------------

# Application base URL (used for canonical links, sitemap.xml, and OpenGraph tags)
APP_URL="https://coupfranc.fr"

# Port on which the application server listens
PORT=3000

# Node environment mode: development | production
NODE_ENV="production"

# Secret key used for signing JWT authentication tokens (Must be min 32 random characters in production)
JWT_SECRET="remplacez-cette-cle-par-une-chaine-aleatoire-securisee-de-32-caracteres"

# PostgreSQL connection string for production VPS deployment
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://coupfranc:MotDePasseTresSecurise2026!@postgres:5432/coupfranc_db?schema=public"

# Database credentials for Docker Compose
POSTGRES_USER="coupfranc"
POSTGRES_PASSWORD="MotDePasseTresSecurise2026!"
POSTGRES_DB="coupfranc_db"

# Optional Gemini API Key if AI assistance features are enabled by administrator
GEMINI_API_KEY=""
