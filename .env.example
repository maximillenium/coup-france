# ------------------------------------------------------------------------------
# CoupFranc Environment Variables Configuration
# ------------------------------------------------------------------------------

# Application base URL (used for canonical links, sitemap.xml, and OpenGraph tags)
APP_URL="https://coupfranc.fr"

# Port on which the application server listens
PORT=3000

# Node environment mode: development | production
NODE_ENV="production"

# Secret key used for signing JWT authentication tokens (Must be min 32 random characters in production)
JWT_SECRET="remplacez-cette-cle-par-une-chaine-aleatoire-securisee-de-32-caracteres"

# Number of reverse proxy hops to trust (default 1 for Nginx on the same host)
TRUST_PROXY_HOPS=1

