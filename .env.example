# ------------------------------------------------------------------------------
# CoupFranc Environment Variables Configuration
# ------------------------------------------------------------------------------

# Application base URL (used for canonical links, sitemap.xml, and OpenGraph tags)
APP_URL="https://coupfranc.fr"

# Port on which the application server listens
PORT=3000

# Node environment mode: development | production
NODE_ENV="production"

# REQUIRED IN PRODUCTION:
# Secret key used for signing and verifying JWT administrator authentication tokens.
# Must be at least 32 characters long with high entropy.
# Generate a cryptographically secure random value using OpenSSL:
#   openssl rand -hex 32
#
# DO NOT leave this empty in production.
# DO NOT use predictable words or placeholders.
JWT_SECRET=""

# REVERSE PROXY CONFIGURATION (TRUST_PROXY_HOPS):
# Number of reverse proxy hops to trust for accurate client IP resolution.
# This MUST strictly match your actual network/reverse-proxy topology:
# - Set to 1: Application is behind a single reverse proxy (e.g. Nginx on the VPS host routing to Docker).
# - Set to 2: Application is behind a dual proxy setup (e.g. Cloudflare / CDN -> Nginx -> Docker).
# - Set to 0: Application is directly exposed to the internet without a reverse proxy.
#
# WARNING: Setting this higher than the actual number of proxy hops could allow attackers
# to forge X-Forwarded-For headers and bypass rate limits.
TRUST_PROXY_HOPS=1
